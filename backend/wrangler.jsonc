{
  "name": "activity-hub-js-local-experiment",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/auth", "/auth/*", "/health", "/health/*", "/docs", "/docs/*", "/redoc", "/openapi.json"]
  },
  "dev": { "ip": "127.0.0.1", "port": 8787 },
  "env": {
    "local": {
      "name": "activity-hub-js-local-experiment",
      "vars": { "WEB_ORIGIN": "http://127.0.0.1:8787" },
      "d1_databases": [{
        "binding": "DB",
        "database_name": "activity-hub-js-local-only",
        "database_id": "00000000-0000-0000-0000-000000000001",
        "migrations_dir": "migrations",
        "remote": false
      }]
    },
    "production": {
      "name": "activity-hub",
      "account_id": "72734ad9e032887b9758d0c2216e3d48",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "WEB_ORIGIN": "https://activity-hub.software-juancho-prego-gundin.workers.dev",
        "TURNSTILE_SITEKEY": "0x4AAAAAAFPTqGIgedBUAMzm",
        "API_ENABLED": "true", "REGISTRATION_ENABLED": "true", "WRITES_ENABLED": "true"
      },
      "ratelimits": [
        { "name": "GLOBAL_RATE_LIMITER", "namespace_id": "41001001", "simple": { "limit": 600, "period": 60 } },
        { "name": "IP_RATE_LIMITER", "namespace_id": "41001002", "simple": { "limit": 120, "period": 60 } },
        { "name": "AUTH_RATE_LIMITER", "namespace_id": "41001003", "simple": { "limit": 10, "period": 60 } },
        { "name": "ACCOUNT_RATE_LIMITER", "namespace_id": "41001004", "simple": { "limit": 60, "period": 60 } }
      ],
      "d1_databases": [{
        "binding": "DB",
        "database_name": "activity-hub-production",
        "database_id": "5ffb5d44-eb8f-4fac-8c2b-5714a1251460",
        "migrations_dir": "migrations"
      }]
    }
  }
}
