{
  "extends": "../../frontend/tsconfig.json",
  "compilerOptions": {
    "types": ["node", "react", "react-dom"],
    "typeRoots": ["../../frontend/node_modules/@types"],
    "paths": {
      "@/*": ["../../frontend/src/*"],
      "react": ["../../frontend/node_modules/@types/react"],
      "react/*": ["../../frontend/node_modules/@types/react/*"],
      "react-dom/*": ["../../frontend/node_modules/@types/react-dom/*"],
      "radix-ui": ["../../frontend/node_modules/radix-ui"],
      "lucide-react": ["../../frontend/node_modules/lucide-react"],
      "class-variance-authority": ["../../frontend/node_modules/class-variance-authority"],
      "clsx": ["../../frontend/node_modules/clsx"],
      "tailwind-merge": ["../../frontend/node_modules/tailwind-merge"],
      "vitest": ["../../frontend/node_modules/vitest"],
      "@testing-library/react": ["../../frontend/node_modules/@testing-library/react"],
      "@testing-library/user-event": ["../../frontend/node_modules/@testing-library/user-event"]
    }
  },
  "include": ["./*.ts", "./*.tsx", "./*.mts"]
}
